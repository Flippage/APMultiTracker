<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:local="clr-namespace:APMultiTracker">

    <local:PillRadius x:Key="PillRadius"/>

    <!-- ============ Palette (matches the canvas) ============ -->
    <FontFamily x:Key="UiFont">Segoe UI Variable Text, Segoe UI</FontFamily>
    <FontFamily x:Key="MonoFont">Cascadia Mono, Consolas</FontFamily>

    <SolidColorBrush x:Key="BgBrush" Color="#000000"/>
    <SolidColorBrush x:Key="SideBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="CardBrush" Color="#161616"/>
    <SolidColorBrush x:Key="FieldBrush" Color="#1C1C1C"/>
    <SolidColorBrush x:Key="FieldDeepBrush" Color="#0D0D0D"/>
    <SolidColorBrush x:Key="LineBrush" Color="#2C2C2C"/>
    <SolidColorBrush x:Key="HoverBrush" Color="#242424"/>
    <SolidColorBrush x:Key="AccentBrush" Color="#22C7E6"/>
    <SolidColorBrush x:Key="AccentDimBrush" Color="#102A30"/>
    <SolidColorBrush x:Key="AccentLineBrush" Color="#1F3B40"/>
    <SolidColorBrush x:Key="TextBrush" Color="#F2F2F2"/>
    <SolidColorBrush x:Key="Text2Brush" Color="#CFCFCF"/>
    <SolidColorBrush x:Key="SubBrush" Color="#9A9A9A"/>
    <SolidColorBrush x:Key="GoodBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="WarnBgBrush" Color="#2A1F0A"/>
    <SolidColorBrush x:Key="WarnLineBrush" Color="#5A4214"/>
    <SolidColorBrush x:Key="WarnTextBrush" Color="#FDE7B0"/>
    <SolidColorBrush x:Key="DangerBrush" Color="#F87171"/>
    <SolidColorBrush x:Key="DangerBgBrush" Color="#2A1212"/>
    <SolidColorBrush x:Key="DangerLineBrush" Color="#5A2424"/>
    <SolidColorBrush x:Key="BlackBrush" Color="#000000"/>

    <!-- Logic states -->
    <SolidColorBrush x:Key="InLogicBrush" Color="#4ADE80"/>
    <SolidColorBrush x:Key="InLogicDimBrush" Color="#10291A"/>
    <SolidColorBrush x:Key="GlitchedBrush" Color="#FBBF24"/>
    <SolidColorBrush x:Key="EntranceBrush" Color="#89F336"/>
    <SolidColorBrush x:Key="EntranceDimBrush" Color="#1C2A0C"/>
    <SolidColorBrush x:Key="OutLogicBrush" Color="#6B6B6B"/>
    <SolidColorBrush x:Key="HintBrush" Color="#C084FC"/>
    <SolidColorBrush x:Key="HintDimBrush" Color="#221432"/>

