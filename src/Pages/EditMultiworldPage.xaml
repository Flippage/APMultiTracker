<UserControl x:Class="APMultiTracker.EditMultiworldPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:APMultiTracker">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="32,26,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
                <DockPanel>
                    <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="M15,5 L8,12 L15,19" ToolTip="Back" Click="Cancel_Click"
                            Margin="-10,0,6,0" VerticalAlignment="Center"/>
                    <TextBlock x:Name="Heading" Text="New multiworld" Style="{StaticResource H1}" VerticalAlignment="Center"/>
                </DockPanel>

                <TextBlock Text="ROOM" Style="{StaticResource Caps}" Margin="0,24,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Text="Name" Style="{StaticResource ItemTitle}" FontSize="13.5"/>
                        <TextBox x:Name="NameBox" Style="{StaticResource Field}" Margin="0,6,0,0" Tag="e.g. Friday multiworld"/>

                        <Grid Margin="0,16,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="2*"/>
                                <ColumnDefinition Width="16"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Server" Style="{StaticResource ItemTitle}" FontSize="13.5"/>
                                <TextBox x:Name="ServerBox" Style="{StaticResource Field}" Margin="0,6,0,0" Tag="archipelago.gg:38281"
                                         FontFamily="{StaticResource MonoFont}" LostFocus="ServerBox_LostFocus"/>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Password (if any)" Style="{StaticResource ItemTitle}" FontSize="13.5"/>
                                <PasswordBox x:Name="PasswordBox" Style="{StaticResource PasswordField}" Margin="0,6,0,0"/>
                            </StackPanel>
                        </Grid>
                        <TextBlock Style="{StaticResource Sub}" Margin="0,8,0,0"
                                   Text="Paste the address from the room page, e.g. archipelago.gg:38281. A /connect line or archipelago:// link works too."/>
                    </StackPanel>
                </Border>

                <DockPanel Margin="0,26,0,8">
                    <TextBlock Text="SLOTS TO TRACK" Style="{StaticResource Caps}" VerticalAlignment="Center"/>
                </DockPanel>
                <Border Style="{StaticResource Card}" Padding="20,14">
                    <StackPanel>
                        <ItemsControl x:Name="SlotList" Focusable="False">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:SlotRef}">
                                    <DockPanel Margin="0,6">
                                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}"
                                                ToolTip="Remove" Click="RemoveSlot_Click"/>
                                        <Border Width="27" Height="36" CornerRadius="3" DockPanel.Dock="Left" Margin="0,0,12,0"
                                                local:Art.Url="{Binding Game, Converter={x:Static local:GameArtConverter.Instance}}"/>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Game}" Width="240" Margin="12,0" VerticalAlignment="Center"
                                                   FontSize="12.5" Foreground="{StaticResource SubBrush}" TextTrimming="CharacterEllipsis"/>
                                        <TextBox Style="{StaticResource FlatField}" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                                                 Tag="Slot name" VerticalAlignment="Center"/>
                                    </DockPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <StackPanel Orientation="Horizontal" Margin="0,10,0,4">
                            <Button Style="{StaticResource OutlineButton}" Height="38" Padding="16,0" FontSize="13" Click="AddSlot_Click">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="12" Height="12" Margin="0,0,8,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconPlus}" Stroke="{StaticResource TextBrush}" StrokeThickness="3"/>
                                    </Viewbox>
                                    <TextBlock Text="Add slot"/>
                                </StackPanel>
                            </Button>
                            <Button x:Name="FindBtn" Style="{StaticResource OutlineButton}" Height="38" Padding="16,0" FontSize="13" Margin="10,0,0,0"
                                    Click="Find_Click" ToolTip="Connect with the first slot name and list everyone in the room">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="13" Height="13" Margin="0,0,8,0">
                                        <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource TextBrush}" StrokeThickness="2.6"/>
                                    </Viewbox>
                                    <TextBlock Text="Find slots in this room"/>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <TextBlock x:Name="FindStatus" Style="{StaticResource Sub}" Margin="0,8,0,0" Visibility="Collapsed"/>
                        <ItemsControl x:Name="RoomPlayers" Margin="0,4,0,0" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel/>
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type local:RoomPlayer}">
                                    <Button Style="{StaticResource ChipButton}" Height="30" Margin="0,6,6,0" FontFamily="{StaticResource UiFont}"
                                            Click="AddPlayer_Click" ToolTip="Add this slot">
                                        <TextBlock>
                                            <Run Text="+ "/><Run Text="{Binding Name, Mode=OneWay}" FontWeight="SemiBold"/><Run Text="  "/><Run Text="{Binding Game, Mode=OneWay}" Foreground="{StaticResource Text2Brush}"/>
                                        </TextBlock>
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>

                <TextBlock Text="PLAYER YAMLS" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
                <Border Style="{StaticResource Card}" Padding="20">
                    <StackPanel>
                        <TextBlock Style="{StaticResource Sub}" FontSize="13"
                                   Text="Many games can rebuild their logic straight from the server. The rest need the player's YAML, just like Universal Tracker. Point this at a folder holding this room's YAMLs, or leave it empty to use Universal Tracker's Players folder."/>
                        <DockPanel Margin="0,12,0,0">
                            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Browse…" Margin="10,0,0,0" Click="Browse_Click"/>
                            <TextBox x:Name="YamlBox" Style="{StaticResource Field}" Tag="Universal Tracker's Players folder"
                                     FontFamily="{StaticResource MonoFont}" FontSize="12.5"/>
                        </DockPanel>
                    </StackPanel>
                </Border>
                <TextBlock x:Name="ErrorText" Foreground="{StaticResource DangerBrush}" Margin="2,14,0,0" TextWrapping="Wrap" Visibility="Collapsed"/>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="1" Background="#0A0A0A" BorderBrush="#1F1F1F" BorderThickness="0,1,0,0" Padding="32,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource OutlineButton}" Click="Cancel_Click"/>
                <Button Content="Save" Style="{StaticResource OutlineButton}" Margin="10,0,0,0" Click="Save_Click"/>
                <Button Content="Save &amp; track" Style="{StaticResource AccentButton}" Margin="10,0,0,0" Click="SaveActivate_Click"/>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
