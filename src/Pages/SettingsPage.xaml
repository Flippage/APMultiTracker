<UserControl x:Class="APMultiTracker.SettingsPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,24">
            <TextBlock Text="Settings" Style="{StaticResource H1}"/>

            <!-- Archipelago + engine -->
            <TextBlock Text="ARCHIPELAGO" Style="{StaticResource Caps}" Margin="0,22,0,8"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12" ClipToBounds="True">
                <StackPanel>
                    <DockPanel Margin="20,16">
                        <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Change…" Height="40" Margin="16,0,0,0"
                                VerticalAlignment="Center" Click="BrowseAp_Click"/>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Archipelago folder" Style="{StaticResource ItemTitle}"/>
                            <TextBlock x:Name="ApPath" Style="{StaticResource Mono}" FontSize="12" Margin="0,4,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>

                    <!-- three checks -->
                    <DockPanel Margin="20,14">
                        <Button x:Name="UtBtn" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Get Universal Tracker" Height="38"
                                Margin="16,0,0,0" VerticalAlignment="Center" Click="GetUt_Click"/>
                        <Border x:Name="UtIcon" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15"><Path x:Name="UtPath" Style="{StaticResource Icon}" StrokeThickness="2.6"/></Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="UtTitle" Style="{StaticResource ItemTitle}"/>
                            <TextBlock x:Name="UtSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <Button x:Name="InstallBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Content="Install engine" Height="38"
                                Margin="16,0,0,0" VerticalAlignment="Center" Click="Install_Click"/>
                        <Border x:Name="EngIcon" DockPanel.Dock="Left" Width="30" Height="30" CornerRadius="15" Margin="0,0,14,0" VerticalAlignment="Center">
                            <Viewbox Width="15" Height="15"><Path x:Name="EngPath" Style="{StaticResource Icon}" StrokeThickness="2.6"/></Viewbox>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="EngTitle" Style="{StaticResource ItemTitle}"/>
                            <TextBlock x:Name="EngSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <Border x:Name="RunRow" BorderThickness="3,0,0,0" Padding="17,14,20,14">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="16,0,0,0">
                                <Button x:Name="LogsBtn" Style="{StaticResource OutlineButton}" Content="Engine logs" Height="38" FontWeight="Normal"
                                        Foreground="{StaticResource Text2Brush}" Click="Logs_Click" Margin="0,0,8,0"/>
                                <Button x:Name="StopBtn" Style="{StaticResource OutlineButton}" Content="Stop" Height="38" Click="Stop_Click" Margin="0,0,8,0"/>
                                <Button x:Name="StartBtn" Style="{StaticResource AccentButton}" Content="Start" Height="38" Click="Start_Click"/>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock x:Name="RunTitle" Style="{StaticResource ItemTitle}"/>
                                <TextBlock x:Name="RunSub" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Border>
            <TextBlock Style="{StaticResource Sub}" FontSize="11.5" Foreground="#7A7A7A" Margin="4,8,0,0" TextWrapping="Wrap"
                       Text="The engine is a small apworld that runs inside Archipelago, so every game you have installed is supported. It uses Universal Tracker's logic and closes when APMultiTracker does."/>

            <!-- Box art -->
            <TextBlock Text="BOX ART" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
            <Border x:Name="SignedOutCard" Style="{StaticResource Card}" Padding="20">
                <StackPanel>
                    <TextBlock Text="Box art comes from Twitch" Style="{StaticResource ItemTitle}"/>
                    <TextBlock Style="{StaticResource Sub}" FontSize="13" Margin="0,4,0,0"
                               Text="Most games are matched by name with no login. Connect Twitch (optional, no permissions) to search for the right art when a game's name doesn't match. Click a game's art on the Tracker to change it."/>
                    <Button x:Name="ConnectBtn" Style="{StaticResource OutlineButton}" Content="Connect Twitch" HorizontalAlignment="Left"
                            Margin="0,14,0,0" Click="Connect_Click"/>
                    <StackPanel x:Name="DevicePanel" Visibility="Collapsed" Margin="0,16,0,0">
                        <StackPanel Orientation="Horizontal">
                            <ItemsControl x:Name="CodeChars">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Width="40" Height="50" CornerRadius="10" Margin="0,0,8,0" Background="#1F1F1F"
                                                BorderBrush="{StaticResource LineBrush}" BorderThickness="2">
                                            <TextBlock Text="{Binding}" FontFamily="{StaticResource MonoFont}" FontSize="22" FontWeight="Bold"
                                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <Button Style="{StaticResource AccentButton}" Content="Open twitch.tv/activate" Click="OpenActivate_Click"/>
                            <Button Style="{StaticResource GhostButton}" Content="Cancel" Click="CancelLogin_Click" Margin="10,0,0,0"/>
                            <TextBlock x:Name="WaitText" Style="{StaticResource Sub}" VerticalAlignment="Center" Margin="16,0,0,0" FontSize="13"/>
                        </StackPanel>
                    </StackPanel>
                    <TextBlock x:Name="LoginError" Foreground="{StaticResource DangerBrush}" TextWrapping="Wrap" Margin="0,12,0,0" Visibility="Collapsed"/>
                </StackPanel>
            </Border>
            <Border x:Name="SignedInCard" Style="{StaticResource Card}" Padding="20,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Disconnect" Click="Disconnect_Click" VerticalAlignment="Center"/>
                    <Border x:Name="ProfileArt" Width="44" Height="44" CornerRadius="22" DockPanel.Dock="Left" Background="#3A3A3A"/>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock x:Name="ProfileName" FontSize="15" FontWeight="Bold"/>
                        <TextBlock Text="Connected · box art search is on" FontSize="12.5" Foreground="{StaticResource GoodBrush}" Margin="0,3,0,0"/>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- App -->
            <TextBlock Text="APP" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
            <Border Background="{StaticResource CardBrush}" CornerRadius="12">
                <StackPanel>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="TopToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Top_Changed" Unchecked="Top_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Always on top" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Keep the tracker above your game windows." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <CheckBox x:Name="StartupToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Checked="Startup_Changed" Unchecked="Startup_Changed"/>
                        <StackPanel>
                            <TextBlock Text="Start with Windows" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Open APMultiTracker when you sign in." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                    <Rectangle Height="1" Fill="#1F1F1F"/>
                    <DockPanel Margin="20,14">
                        <TextBlock DockPanel.Dock="Right" Style="{StaticResource Mono}" FontSize="12" VerticalAlignment="Center"
                                   Text="Ctrl+1…9 · Ctrl+0 · Ctrl+Tab"/>
                        <StackPanel>
                            <TextBlock Text="Keyboard shortcuts" Style="{StaticResource ItemTitle}"/>
                            <TextBlock Text="Focus a game by number, show all games, or step through them." Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                        </StackPanel>
                    </DockPanel>
                </StackPanel>
            </Border>

            <TextBlock Text="STORAGE &amp; DIAGNOSTICS" Style="{StaticResource Caps}" Margin="0,26,0,8"/>
            <Border Style="{StaticResource Card}" Padding="20,16">
                <DockPanel>
                    <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Open log folder" Height="40"
                            Click="OpenLogs_Click" VerticalAlignment="Center" Margin="16,0,0,0"/>
                    <TextBlock Style="{StaticResource Sub}" VerticalAlignment="Center">
                        <Run Text="Settings are stored in "/><Run x:Name="ConfigPathRun" FontFamily="{StaticResource MonoFont}"/><Run Text=". Room passwords and the Twitch token are encrypted for your Windows user."/>
                    </TextBlock>
                </DockPanel>
            </Border>
            <TextBlock x:Name="VersionText" Style="{StaticResource Sub}" FontSize="11.5" Foreground="#7A7A7A" Margin="4,10,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
