<UserControl x:Class="APMultiTracker.FeedPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:APMultiTracker">
    <Grid Margin="32,26,32,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <DockPanel Margin="0,0,0,16">
            <Button DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Padding="18,0" Click="Clear_Click"
                    ToolTip="Clear the messages shown here (the room isn't affected)">
                <TextBlock Text="Clear" FontWeight="Normal" Foreground="{StaticResource Text2Brush}"/>
            </Button>
            <StackPanel>
                <TextBlock Text="Feed" Style="{StaticResource H1}"/>
                <TextBlock x:Name="SubText" Style="{StaticResource Sub}" FontSize="13" Margin="0,4,0,0" TextTrimming="CharacterEllipsis"/>
            </StackPanel>
        </DockPanel>

        <local:FeedPanel x:Name="Panel" Grid.Row="1"/>
    </Grid>
</UserControl>
