<UserControl x:Class="APMultiTracker.PatchNotesPage"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer x:Name="Scroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="32,26,32,24" MaxWidth="900" HorizontalAlignment="Stretch">
            <DockPanel>
                <Button DockPanel.Dock="Left" Style="{StaticResource IconButton}" Tag="M15,5 L8,12 L15,19" ToolTip="Back" Click="Back_Click"
                        Margin="-10,0,6,0" VerticalAlignment="Center"/>
                <Button x:Name="ToggleAllBtn" DockPanel.Dock="Right" Style="{StaticResource OutlineButton}" Content="Expand all" Height="36"
                        Padding="14,0" FontSize="12.5" VerticalAlignment="Center" Click="ToggleAll_Click"/>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="Patch notes" Style="{StaticResource H1}"/>
                    <TextBlock x:Name="SubText" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
            <StackPanel x:Name="List" Margin="0,20,0,0"/>
            <TextBlock x:Name="Empty" Style="{StaticResource Sub}" Margin="0,20,0,0" Visibility="Collapsed"
                       Text="The patch notes aren't available in this build."/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
