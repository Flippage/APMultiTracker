<UserControl x:Class="APMultiTracker.FeedPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:APMultiTracker">
    <!-- The room's messages: filters, list and the chat box. Used by the Feed page and docked in the Tracker. -->
    <UserControl.Resources>
        <!-- Docked: tighter rows so more messages fit -->
        <Style x:Key="DenseRow" TargetType="ListBoxItem">
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Bd" CornerRadius="6" Padding="6,1" Background="Transparent">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource HoverBrush}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Docked only: a small title bar with dock position and close -->
        <DockPanel x:Name="DockHeader" Margin="2,0,0,8" Visibility="Collapsed">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button x:Name="DockRightBtn" Style="{StaticResource IconButton}" Width="30" Height="30" Click="DockRight_Click"
                        Tag="M3,5 L21,5 L21,19 L3,19 Z M15,5 L15,19" ToolTip="Show the feed on the right"/>
                <Button x:Name="DockBottomBtn" Style="{StaticResource IconButton}" Width="30" Height="30" Click="DockBottom_Click"
                        Tag="M3,5 L21,5 L21,19 L3,19 Z M3,14 L21,14" ToolTip="Show the feed along the bottom"/>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}" Width="30" Height="30" Click="Close_Click"
                        ToolTip="Hide the feed"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Viewbox Width="14" Height="14" Margin="0,0,8,0">
                    <Path Style="{StaticResource Icon}" Data="{StaticResource IconChat}" Stroke="{StaticResource AccentBrush}"/>
                </Viewbox>
                <TextBlock Text="FEED" Style="{StaticResource Caps}" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center"/>
                <TextBlock x:Name="DockCount" Style="{StaticResource Caps}" FontWeight="Normal" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
        </DockPanel>

        <DockPanel x:Name="FilterBar" Grid.Row="1" Margin="0,0,0,10">
            <CheckBox x:Name="MineToggle" DockPanel.Dock="Right" Style="{StaticResource Toggle}" Content="Only my slots" FontSize="12.5"
                      VerticalAlignment="Top" Margin="8,4,0,0"
                      Checked="Filter_Changed" Unchecked="Filter_Changed"
                      ToolTip="Only messages involving the slots you're tracking"/>
            <WrapPanel VerticalAlignment="Center">
                <RadioButton x:Name="AllPill" Style="{StaticResource FilterPill}" Tag="All" Checked="Filter_Changed">All</RadioButton>
                <RadioButton x:Name="ItemsPill" Style="{StaticResource FilterPill}" Tag="Items" Checked="Filter_Changed">Items</RadioButton>
                <RadioButton x:Name="HintsPill" Style="{StaticResource FilterPill}" Tag="Hints" Checked="Filter_Changed">Hints</RadioButton>
                <RadioButton x:Name="ChatPill" Style="{StaticResource FilterPill}" Tag="Chat" Checked="Filter_Changed">Chat</RadioButton>
                <RadioButton x:Name="ActivityPill" Style="{StaticResource FilterPill}" Tag="Activity" Checked="Filter_Changed"
                             ToolTip="Joins, goals, releases and server notices">Activity</RadioButton>
            </WrapPanel>
        </DockPanel>

        <ListBox x:Name="List" Grid.Row="2" Style="{StaticResource CheckList}" ScrollViewer.ScrollChanged="List_ScrollChanged">
            <ListBox.ItemTemplate>
                <DataTemplate DataType="{x:Type local:FeedRow}">
                    <Border x:Name="Bd" CornerRadius="6" Padding="9,4,8,4" Margin="-6,0,0,0" BorderThickness="3,0,0,0"
                            BorderBrush="Transparent" Background="Transparent">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Left" Text="{Binding Message.TimeText}" Style="{StaticResource Mono}" FontSize="11"
                                       Foreground="#6A6A6A" Width="40" Margin="0,2,6,0" VerticalAlignment="Top"/>
                            <TextBlock local:Segments.Source="{Binding Message.Segments}" FontSize="{Binding FontSize, RelativeSource={RelativeSource AncestorType=local:FeedPanel}}"
                                       TextWrapping="Wrap" Foreground="{StaticResource Text2Brush}" LineHeight="20"/>
                        </DockPanel>
                    </Border>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Mine}" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource InLogicDimBrush}"/>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource InLogicBrush}"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
            <ListBox.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Copy message" Click="Copy_Click"/>
                </ContextMenu>
            </ListBox.ContextMenu>
        </ListBox>
        <StackPanel x:Name="EmptyState" Grid.Row="2" VerticalAlignment="Center" HorizontalAlignment="Center" IsHitTestVisible="False" Margin="12">
            <Viewbox Width="34" Height="34" Opacity="0.35" HorizontalAlignment="Center">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconChat}" Stroke="{StaticResource TextBrush}" StrokeThickness="1.6"/>
            </Viewbox>
            <TextBlock x:Name="EmptyTitle" Style="{StaticResource ItemTitle}" HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock x:Name="EmptySub" Style="{StaticResource Sub}" HorizontalAlignment="Center" TextAlignment="Center" Margin="0,4,0,0"/>
        </StackPanel>

        <Button x:Name="JumpBtn" Grid.Row="2" Style="{StaticResource ChipButton}" FontFamily="{StaticResource UiFont}" Height="30"
                HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12" Visibility="Collapsed"
                Content="New messages ↓" Click="Jump_Click"/>

        <!-- Say / commands -->
        <Border x:Name="ChatBar" Grid.Row="3" Margin="0,10,0,0" Background="{StaticResource CardBrush}" CornerRadius="12" Padding="10">
            <StackPanel>
                <TextBlock x:Name="SendError" Foreground="{StaticResource DangerBrush}" FontSize="12" Margin="4,0,0,8" TextWrapping="Wrap"
                           Visibility="Collapsed"/>
                <DockPanel>
                    <Button x:Name="SendBtn" DockPanel.Dock="Right" Style="{StaticResource AccentButton}" Height="40" Padding="20,0"
                            Content="Send" Margin="10,0,0,0" Click="Send_Click"/>
                    <Button x:Name="AsBtn" DockPanel.Dock="Left" Style="{StaticResource OutlineButton}" Height="40" Padding="14,0" FontSize="13"
                            Margin="0,0,10,0" Click="As_Click" ToolTip="Which of your slots sends the message">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="AsLabel" Text="as " Foreground="{StaticResource SubBrush}" FontWeight="Normal"/>
                            <TextBlock x:Name="AsText" FontWeight="SemiBold" MaxWidth="140" TextTrimming="CharacterEllipsis"/>
                            <Viewbox Width="10" Height="10" Margin="8,1,0,0">
                                <Path Style="{StaticResource Icon}" Data="M6,9 L12,15 L18,9" Stroke="{StaticResource Text2Brush}" StrokeThickness="3"/>
                            </Viewbox>
                        </StackPanel>
                    </Button>
                    <TextBox x:Name="Input" Style="{StaticResource Field}" MinHeight="40" FontSize="13.5"
                             Tag="Message the room, or a command like !hint Hookshot" KeyDown="Input_KeyDown"/>
                </DockPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
