<UserControl x:Class="APMultiTracker.CategoryPicker"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:APMultiTracker">
    <UserControl.Resources>
        <DataTemplate x:Key="ResultTemplate" DataType="{x:Type local:CategoryRef}">
            <DockPanel>
                <Border Width="39" Height="52" CornerRadius="4" local:Art.Url="{Binding BoxArtUrl}" DockPanel.Dock="Left"/>
                <TextBlock Text="{Binding Name}" Margin="14,0,0,0" VerticalAlignment="Center" FontSize="14" FontWeight="SemiBold"
                           TextWrapping="Wrap"/>
            </DockPanel>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>
        <Border x:Name="SelectedCard" Visibility="Collapsed" Margin="0,0,0,8" Padding="10" CornerRadius="12"
                Background="{StaticResource AccentDimBrush}" BorderBrush="{StaticResource AccentBrush}" BorderThickness="2">
            <DockPanel>
                <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}"
                        ToolTip="Clear" Click="Clear_Click" VerticalAlignment="Center"/>
                <Border x:Name="SelectedArt" Width="45" Height="60" CornerRadius="4" DockPanel.Dock="Left"/>
                <StackPanel Margin="14,0,8,0" VerticalAlignment="Center">
                    <TextBlock x:Name="SelectedName" Style="{StaticResource ItemTitle}" TextWrapping="Wrap"/>
                    <TextBlock Text="Selected box art" Style="{StaticResource Sub}" Margin="0,2,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <Grid>
            <TextBox x:Name="Query" Style="{StaticResource Field}" Padding="38,0,12,0" Tag="Search Twitch for box art…"
                     TextChanged="Query_TextChanged" PreviewKeyDown="Query_PreviewKeyDown" GotKeyboardFocus="Query_GotFocus"/>
            <Viewbox Width="18" Height="18" HorizontalAlignment="Left" Margin="14,0,0,0" IsHitTestVisible="False">
                <Path Style="{StaticResource Icon}" Data="{StaticResource IconSearch}" Stroke="{StaticResource Text2Brush}"/>
            </Viewbox>
        </Grid>

        <TextBlock x:Name="Status" Style="{StaticResource Sub}" Margin="4,8,0,0" Visibility="Collapsed"/>

        <!-- Results float over the window instead of growing the page. -->
        <Popup x:Name="ResultsPopup" PlacementTarget="{Binding ElementName=Query}" Placement="Bottom" VerticalOffset="6"
               StaysOpen="True" AllowsTransparency="True" PopupAnimation="Fade" Focusable="False">
            <Border Width="{Binding ActualWidth, ElementName=Query}" Background="#1A1A1A"
                    BorderBrush="{StaticResource LineBrush}" BorderThickness="2" CornerRadius="12"
                    TextElement.FontFamily="{StaticResource UiFont}" TextElement.Foreground="{StaticResource TextBrush}">
                <ListBox x:Name="Results" Style="{StaticResource ResultList}" Background="Transparent" MaxHeight="360"
                         ItemTemplate="{StaticResource ResultTemplate}"
                         PreviewMouseLeftButtonUp="Results_Click" KeyDown="Results_KeyDown"/>
            </Border>
        </Popup>
    </StackPanel>
</UserControl>
